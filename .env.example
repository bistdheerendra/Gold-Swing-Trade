# Application
APP_NAME=Gold Swing AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market defaults
MARKET_SYMBOL=PAXGUSD
DEFAULT_TIMEFRAME=1h
RISK_PERCENT=1.0
MIN_RR=1.5
MIN_ML_PROBABILITY=0.65
MAX_SPREAD=0.5
ATR_MULTIPLIER=1.5
STRATEGY_VERSION=1.0.0
MODEL_VERSION=none

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=goldtrader
POSTGRES_PASSWORD=goldtrader_dev_change_me
POSTGRES_DB=gold_swing_ai
DATABASE_URL=postgresql+asyncpg://goldtrader:goldtrader_dev_change_me@localhost:5432/gold_swing_ai

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Market data — Phase 11.5 real free-tier providers (NO mock as default)
# delta_india: authoritative PAXGUSD candles from Delta Exchange India (no API key)
# twelvedata: optional XAU/USD reference only (free API key required)
# mock: ONLY with ALLOW_MOCK_DATA=true (pytest suite) — never for the running app
MARKET_DATA_PROVIDER=delta_india
MARKET_DATA_STORE=memory
ALLOW_MOCK_DATA=false
DELTA_INDIA_BASE_URL=https://api.india.delta.exchange
# Verified against GET /v2/products (do not assume without confirmation)
DELTA_PAXGUSD_SYMBOL=PAXGUSD
TWELVEDATA_API_BASE_URL=https://api.twelvedata.com
# Get a free key at https://twelvedata.com (only if using twelvedata / XAUUSD reference)
TWELVEDATA_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
